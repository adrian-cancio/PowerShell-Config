{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        { "type": "os", "style": "plain", "foreground": "#928374", "template": "{{ .Icon }} " },
        { "type": "session", "style": "plain", "foreground": "#fabd2f", "template": "{{ if .SSHSession }}<#928374>[SSH] </>{{ end }}{{ if or .WSL .Env.WSL_DISTRO_NAME }}<#928374>[WSL] </>{{ end }}{{ if or .Env.CONTAINER .Env.DISTROBOX_ENTERED }}<#928374>[CONTAINER] </>{{ end }}{{ if .Root }}<#fb4934>[ADMIN] </>{{ end }}{{ .UserName }}<#928374>@</>{{ .HostName }}<#928374> | </>" },
        { "type": "path", "style": "plain", "foreground": "#fabd2f", "template": "{{ .Path }}", "options": { "style": "full" } },
        { "type": "python", "style": "plain", "foreground": "#fabd2f", "template": " <#928374>[</>py:{{ .Venv }}<#928374>]</>", "options": { "display_mode": "environment", "fetch_virtual_env": true, "display_default": true, "home_enabled": true } },
        { "type": "status", "style": "plain", "foreground": "#fb4934", "template": " ✗{{ .Code }}" },
        { "type": "executiontime", "style": "plain", "foreground": "#928374", "template": " {{ .FormattedMs }}", "options": { "threshold": 2000, "style": "roundrock" } }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "git", "style": "plain", "foreground": "#fabd2f",
          "template": "{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Staging.Changed }} <#b8bb26>{{ .Staging.String }}</>{{ end }}{{ if .Working.Changed }} <#fabd2f>~{{ .Working.String }}</>{{ end }}{{ if not (or .Working.Changed .Staging.Changed) }} <#b8bb26>✓</>{{ end }}<#928374> | </>",
          "options": { "fetch_status": true }
        },
        { "type": "status", "style": "plain", "foreground": "#b8bb26", "foreground_templates": [ "{{ if gt .Code 0 }}#fb4934{{ end }}" ], "template": "|>", "options": { "always_enabled": true } }
      ]
    }
  ]
}
